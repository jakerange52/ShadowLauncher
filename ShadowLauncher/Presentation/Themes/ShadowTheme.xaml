<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════ Color Palette (lifted for low-contrast displays) ═══════ -->
    <Color x:Key="ShadowBg">#101014</Color>
    <Color x:Key="ShadowSurface">#2E2E34</Color>
    <Color x:Key="ShadowSurfaceAlt">#3A3A42</Color>
    <Color x:Key="ShadowBorder">#585862</Color>
    <Color x:Key="ShadowRed">#8A2222</Color>
    <Color x:Key="ShadowRedHover">#B03333</Color>
    <Color x:Key="ShadowRedPress">#4A0808</Color>
    <Color x:Key="ShadowText">#F0F0F0</Color>
    <Color x:Key="ShadowTextMuted">#A0A0A8</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ShadowBg}" Opacity="0.95"/>
    <!-- Surface: deep crimson with a soft inner glow bloom -->
    <DrawingBrush x:Key="SurfaceBrush"
                  TileMode="None"
                  Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox"
                  Viewbox="0,0,600,400" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#481818" Offset="0.0"/>
                            <GradientStop Color="#341414" Offset="0.45"/>
                            <GradientStop Color="#281010" Offset="0.75"/>
                            <GradientStop Color="#1A0808" Offset="1.0"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1" Opacity="0.25">
                            <GradientStop Color="#521818" Offset="0.0"/>
                            <GradientStop Color="#241010" Offset="0.5"/>
                            <GradientStop Color="#3E1414" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.15">
                            <GradientStop Color="#1A0808" Offset="0.0"/>
                            <GradientStop Color="#521C1C" Offset="0.5"/>
                            <GradientStop Color="#281010" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ShadowSurfaceAlt}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ShadowBorder}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ShadowRed}"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource ShadowRedHover}"/>
    <SolidColorBrush x:Key="RedPressBrush" Color="{StaticResource ShadowRedPress}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ShadowText}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ShadowTextMuted}"/>
    <SolidColorBrush x:Key="BetaBadgeBrush" Color="#F5C842"/>

    <!-- ═══════ Theme contract (consumed by BaseTheme.xaml) ═══════ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F0101018"/>

    <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ShadowRed}"/>
    <SolidColorBrush x:Key="ButtonFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ShadowRedHover}"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="{StaticResource ShadowRedPress}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
    <Thickness x:Key="ButtonBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="ButtonDisabledBgBrush" Color="#404048"/>
    <SolidColorBrush x:Key="ButtonDisabledFgBrush" Color="#888890"/>
    <Color x:Key="ButtonGlowColor">Black</Color>
    <sys:Double x:Key="ButtonGlowBlur">10</sys:Double>
    <sys:Double x:Key="ButtonGlowDepth">2</sys:Double>
    <sys:Double x:Key="ButtonGlowOpacity">0.6</sys:Double>

    <SolidColorBrush x:Key="IconFgBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="IconHoverBrush" Color="#484850"/>
    <SolidColorBrush x:Key="ArrowFillBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="CaretBrush" Color="{StaticResource ShadowText}"/>

    <!-- DataGrid header + hovered list item: the crimson surface bloom -->
    <DrawingBrush x:Key="AltSurfaceBrush"
                  TileMode="None"
                  Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox"
                  Viewbox="0,0,600,400" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#481818" Offset="0.0"/>
                            <GradientStop Color="#341414" Offset="0.45"/>
                            <GradientStop Color="#281010" Offset="0.75"/>
                            <GradientStop Color="#1A0808" Offset="1.0"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1" Opacity="0.25">
                            <GradientStop Color="#521818" Offset="0.0"/>
                            <GradientStop Color="#241010" Offset="0.5"/>
                            <GradientStop Color="#3E1414" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.15">
                            <GradientStop Color="#1A0808" Offset="0.0"/>
                            <GradientStop Color="#521C1C" Offset="0.5"/>
                            <GradientStop Color="#281010" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="RowSelectedBgBrush" Color="#77882222"/>
    <SolidColorBrush x:Key="RowSelectedFgBrush" Color="{StaticResource ShadowText}"/>

    <SolidColorBrush x:Key="ListSelectedFgBrush" Color="White"/>
    <SolidColorBrush x:Key="SelectedFgBrush" Color="White"/>

    <SolidColorBrush x:Key="TrackBrush" Color="#26262E"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#585862"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#707078"/>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BaseTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
