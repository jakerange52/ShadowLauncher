<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════ Color Palette (lifted for low-contrast displays) ═══════ -->
    <Color x:Key="ShadowBg">#121228</Color>
    <Color x:Key="ShadowSurface">#1E1E40</Color>
    <Color x:Key="ShadowSurfaceAlt">#282850</Color>
    <Color x:Key="ShadowBorder">#5050A0</Color>
    <Color x:Key="ShadowRed">#5858C8</Color>
    <Color x:Key="ShadowRedHover">#7070E8</Color>
    <Color x:Key="ShadowRedPress">#242470</Color>
    <Color x:Key="ShadowText">#E8E8FF</Color>
    <Color x:Key="ShadowTextMuted">#8080B8</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ShadowBg}" Opacity="0.95"/>
    <!-- Surface: deep purple with a soft inner glow bloom -->
    <DrawingBrush x:Key="SurfaceBrush"
                  TileMode="None"
                  Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox"
                  Viewbox="0,0,600,400" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#342848" Offset="0.0"/>
                            <GradientStop Color="#281E38" Offset="0.45"/>
                            <GradientStop Color="#1C1428" Offset="0.75"/>
                            <GradientStop Color="#141020" Offset="1.0"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1" Opacity="0.25">
                            <GradientStop Color="#3C2854" Offset="0.0"/>
                            <GradientStop Color="#181028" Offset="0.5"/>
                            <GradientStop Color="#302048" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.15">
                            <GradientStop Color="#141020" Offset="0.0"/>
                            <GradientStop Color="#403058" Offset="0.5"/>
                            <GradientStop Color="#1C1428" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ShadowSurfaceAlt}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ShadowBorder}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource ShadowRed}"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="{StaticResource ShadowRedHover}"/>
    <SolidColorBrush x:Key="RedPressBrush" Color="{StaticResource ShadowRedPress}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ShadowText}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ShadowTextMuted}"/>
    <SolidColorBrush x:Key="BetaBadgeBrush" Color="#F5C842"/>

    <!-- ═══════ Theme contract (consumed by BaseTheme.xaml) ═══════ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F0121228"/>

    <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ShadowRed}"/>
    <SolidColorBrush x:Key="ButtonFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ShadowRedHover}"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="{StaticResource ShadowRedPress}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
    <Thickness x:Key="ButtonBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="ButtonDisabledBgBrush" Color="#404048"/>
    <SolidColorBrush x:Key="ButtonDisabledFgBrush" Color="#888890"/>
    <Color x:Key="ButtonGlowColor">#4040CC</Color>
    <sys:Double x:Key="ButtonGlowBlur">12</sys:Double>
    <sys:Double x:Key="ButtonGlowDepth">2</sys:Double>
    <sys:Double x:Key="ButtonGlowOpacity">0.7</sys:Double>

    <SolidColorBrush x:Key="IconFgBrush" Color="#A0A0E0"/>
    <!-- Icon hover: the purple surface bloom -->
    <DrawingBrush x:Key="IconHoverBrush"
                  TileMode="None"
                  Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox"
                  Viewbox="0,0,600,400" ViewboxUnits="Absolute"
                  Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#342848" Offset="0.0"/>
                            <GradientStop Color="#281E38" Offset="0.45"/>
                            <GradientStop Color="#1C1428" Offset="0.75"/>
                            <GradientStop Color="#141020" Offset="1.0"/>
                        </RadialGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1" Opacity="0.25">
                            <GradientStop Color="#3C2854" Offset="0.0"/>
                            <GradientStop Color="#181028" Offset="0.5"/>
                            <GradientStop Color="#302048" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M0,0 H600 V400 H0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.15">
                            <GradientStop Color="#141020" Offset="0.0"/>
                            <GradientStop Color="#403058" Offset="0.5"/>
                            <GradientStop Color="#1C1428" Offset="1.0"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="ArrowFillBrush" Color="#A0A0E0"/>
    <SolidColorBrush x:Key="CaretBrush" Color="{StaticResource ShadowText}"/>

    <SolidColorBrush x:Key="AltSurfaceBrush" Color="{StaticResource ShadowSurfaceAlt}"/>
    <SolidColorBrush x:Key="RowSelectedBgBrush" Color="#775858C8"/>
    <SolidColorBrush x:Key="RowSelectedFgBrush" Color="{StaticResource ShadowText}"/>

    <SolidColorBrush x:Key="ListSelectedFgBrush" Color="White"/>
    <SolidColorBrush x:Key="SelectedFgBrush" Color="White"/>

    <SolidColorBrush x:Key="TrackBrush" Color="#26262E"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="{StaticResource ShadowBorder}"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{StaticResource ShadowRedHover}"/>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BaseTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
