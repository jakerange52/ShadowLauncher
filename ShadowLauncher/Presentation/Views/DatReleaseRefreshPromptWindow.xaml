<Window x:Class="ShadowLauncher.Presentation.Views.DatReleaseRefreshPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAT Update Available" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" WindowStyle="None" AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="12" GlassFrameThickness="0" CaptionHeight="28" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="16">
            <DockPanel VerticalAlignment="Top" Margin="0,-8,0,0" Height="28">
                <TextBlock Text="DAT Update Available" Foreground="#888" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="8,2" FontSize="11" Click="Close_Click"
                        Style="{DynamicResource IconButton}" Foreground="#888" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </DockPanel>
            <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="A newer published DAT release is available for:"
                           TextWrapping="Wrap" Foreground="#DDD" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="160" Margin="0,0,0,12">
                    <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Foreground="#AAA" FontFamily="Consolas"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Launch with current DATs" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Refresh DATs" Padding="14,6" FontWeight="Bold" IsDefault="True" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
