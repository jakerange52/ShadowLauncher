<Window x:Class="ShadowLauncher.Presentation.Views.DatMismatchPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAT Mismatch" Height="200" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" WindowStyle="None" AllowsTransparency="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="12" GlassFrameThickness="0" CaptionHeight="28" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="DAT Mismatch detected, would you like to refresh DATs?"
                       TextWrapping="Wrap" Foreground="#DDDDDD" Margin="0,0,0,20"
                       FontFamily="Palatino Linotype, Book Antiqua, Georgia, serif" FontSize="13"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="No" Padding="16,6" Margin="0,0,8,0" IsCancel="True" Click="No_Click"/>
                <Button Content="Yes" Padding="16,6" FontWeight="Bold" IsDefault="True" Click="Yes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
