<Window x:Class="ShadowLauncher.Presentation.Views.DatVersionCheckingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShadowLauncher" Height="140" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="12" GlassFrameThickness="0" CaptionHeight="28" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.7"/>
        </Border.Effect>
        <StackPanel Margin="28,24" HorizontalAlignment="Center">
            <TextBlock Text="Checking dat versions..."
                       FontFamily="Palatino Linotype, Book Antiqua, Georgia, serif"
                       FontSize="14" Foreground="#DDDDDD" HorizontalAlignment="Center"/>
            <ProgressBar Height="8" Margin="0,16,0,0" IsIndeterminate="True"
                         Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         Foreground="{DynamicResource RedBrush}"/>
        </StackPanel>
    </Border>
</Window>
